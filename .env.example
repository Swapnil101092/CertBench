# Copy this file to .env and fill in real values before running the server.

# Required. A long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. Port the server listens on (most hosts set this for you automatically).
PORT=3000

# Optional. Where the SQLite database file is stored.
DB_PATH=./data/certbench.db

# Optional but required for REAL email delivery of the OTP code. Leave blank
# to use the dev fallback, which logs the OTP to the server console instead
# of emailing it. Free forever, no billing — see README section 2 for the
# 5-minute Gmail app-password setup.
EMAIL_USER=
EMAIL_PASS=
# Optional: display name/address the email appears to come from.
# Defaults to "CertBench <EMAIL_USER>" if left blank.
EMAIL_FROM=
# Optional: only needed if using a non-Gmail SMTP provider (Brevo, Resend, etc).
# Leave all three blank to use Gmail's SMTP automatically.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=

# Optional but required for REAL payment collection on paid exams. Leave
# blank to use the dev fallback, which enrolls people for free instantly
# instead of opening a payment window.
# Get Test Mode keys (no KYC needed) from https://dashboard.razorpay.com
# Settings -> API Keys, after signing up.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin panel (/admin): comma-separated email addresses of accounts that get admin access.
# Only works when the EMAIL_* settings above are filled in (so signing in needs the emailed code).
# The account must be registered on the site with exactly this email. Remove an address to revoke.
# ADMIN_EMAILS=you@example.com
